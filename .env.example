# TicketPilot environment variables (names only, fill in your own values).
# Copy to .env and never commit .env.

# --- LLM keys (never commit real keys) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
GROQ_API_KEY_11=
ENABLE_OPENROUTER=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BUDGET_USD=1.5
OPENAI_PRICE_PER_1K_TOKENS=

# --- Optional API access control (local demo, no login) ---
# If set, the API requires the X-API-Token header on /triage, /approvals/*,
# /tickets*, /audit/* and /keys/status. /health stays open. The UI sends it
# automatically when set. Leave empty to disable.
APP_API_TOKEN=
# Requests per minute per client on POST /triage (0 disables rate limiting).
RATE_LIMIT_PER_MIN=30

# --- Behavior ---
CONFIDENCE_THRESHOLD=0.75
KB_MIN_SCORE=0.25
LLM_PROVIDER=groq
GROQ_MODEL=
OPENROUTER_MODEL=

# --- Langfuse (optional; app runs without it) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Paths ---
AUDIT_DB_PATH=data/audit.db
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
API_BASE_URL=http://127.0.0.1:8000
